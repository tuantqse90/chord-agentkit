{
  "name": "chord-agentkit",
  "version": "0.1.0",
  "description": "Chord swap actions for Coinbase AgentKit: best-route quotes and swaps through the Chord router on eight EVM chains.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "eslint -c .eslintrc.json \"src/**/*.ts\"",
    "lint:fix": "eslint -c .eslintrc.json \"src/**/*.ts\" --fix",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier -c \"**/*.{ts,json,md}\"",
    "test": "jest --no-cache",
    "test:types": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run test && npm run build"
  },
  "keywords": [
    "agentkit",
    "coinbase",
    "chord",
    "swap",
    "dex-aggregator",
    "ai",
    "agent",
    "evm"
  ],
  "homepage": "https://getchord.xyz/docs",
  "peerDependencies": {
    "@coinbase/agentkit": ">=0.10.0",
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@coinbase/agentkit": "0.10.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.12.11",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsdoc": "^48.2.5",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "reflect-metadata": "^0.2.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2",
    "viem": "2.38.3",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=18"
  }
}
